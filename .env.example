# Database Provider Selection
# Set to 'aws' to use AWS RDS, or 'railway' to use Railway PostgreSQL
DB_PROVIDER=aws

# AWS RDS PostgreSQL (Primary)
AWS_DATABASE_URL=postgresql://postgres:{password}@gateway-monitor-db-1.clqqw4e0c04j.eu-north-1.rds.amazonaws.com:5432/postgres

# Railway PostgreSQL (Backup - Railway will provide this automatically)
# RAILWAY_DATABASE_URL=postgresql://user:password@proxy.rlwy.net:12345/railway
# Or use the old DATABASE_URL variable (will be used as fallback)
DATABASE_URL=postgresql://user:password@localhost:5432/gateway_monitor

# OpenAI API Key (get from https://platform.openai.com/api-keys)
# Use OPENAI_API_KEY for local development
OPENAI_API_KEY=sk-your-key-here
# Use AI_INTEGRATIONS_OPENAI_API_KEY for Replit (automatically set by Replit AI Integrations)
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# Email alerts (Zoho SMTP)
# To get app-specific password: Zoho Mail > Settings > Security > App Passwords
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USERNAME=your-email@yourdomain.com
SMTP_PASSWORD=your-app-specific-password
ALERT_FROM_EMAIL=your-email@yourdomain.com
ALERT_FROM_NAME=Gateway Monitor

# Monitoring schedule (hours)
CRAWL_SCHEDULE_HOURS=24

# Weekly digest schedule (0=Monday, 6=Sunday)
WEEKLY_DIGEST_DAY=0
WEEKLY_DIGEST_HOUR=9
